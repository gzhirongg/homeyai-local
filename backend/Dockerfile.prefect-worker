# Lightweight worker image for Prefect flows that import ``modelling`` (training + snapshots).
FROM prefecthq/prefect:3-python3.11

RUN pip install --no-cache-dir \
    "modal>=0.64" \
    "minio>=7.2" \
    "pandas>=2.0" \
    "pyarrow>=14.0" \
    "numpy>=1.24" \
    "scikit-learn>=1.3" \
    "scipy>=1.10" \
    "matplotlib>=3.7" \
    "seaborn>=0.13" \
    "joblib>=1.3" \
    "category-encoders>=2.6" \
    "xgboost>=2.0" \
    "python-dotenv" \
    "sqlalchemy" \
    "psycopg2-binary" \
    "httpx" \
    "lightgbm>=4.0"

WORKDIR /workspace/backend
