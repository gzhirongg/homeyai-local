# ==============================================================================
# HomeyAI: Environment Configuration System
# ==============================================================================
# HOW TO USE:
# 1. Copy this file to '.env' (cp .env.example .env)
# 2. Fill in the required API keys (URA_API_KEY).
# 3. Choose your 'Mode' by uncommenting the appropriate section below.
# 4. Start the app:
#      Local dev:  docker compose -f docker-compose.dev.yml up --build
#      VM server:  docker compose -f docker-compose.prod.yml up --build
#
# See docs/reference/environment-variables.md for full details.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SHARED CONFIG (Required for all modes)
# ------------------------------------------------------------------------------
# Admin Postgres user (backend, Alembic when URL not exported, Docker Postgres image)
ADMIN_DB_USER=admin
ADMIN_DB_PASSWORD=password123
# Optional explicit admin URL (preferred over DATABASE_URL when both are set; see docs/reference/environment-variables.md):
# DATABASE_URL_ADMIN=postgresql://${ADMIN_DB_USER}:${ADMIN_DB_PASSWORD}@${DB_HOST}:${DB_INNER_PORT}/${DB_NAME}
# If DATABASE_URL_* uses ${DB_PORT}, set: DB_PORT=${DB_INNER_PORT}
# DB_NAME changes based on mode, see below.
URA_API_KEY=your_ura_api_key_here
# OneMap API credentials (primary + failover account)
ONEMAP_EMAIL_1=your_onemap_email_here
ONEMAP_PASSWORD_1=your_onemap_password_here
ONEMAP_EMAIL_2=your_second_onemap_email_here
ONEMAP_PASSWORD_2=your_second_onemap_password_here
# MAS Domestic Interest Rates API — required for the Market Sentiment interest rate signal.
# Apply at: https://eservices.mas.gov.sg/apimg-gw (free registration)
MAS_API_KEY=your_mas_api_key_here

# ------------------------------------------------------------------------------
# 2. REMOTE DEPLOYMENT CONFIGURATION
# ------------------------------------------------------------------------------
# Reachable hostname or IP for the VM (Tailscale mesh IP, public cloud IP, or DNS)—
# one address your team uses for browser + SSH + services. Backend CORS adds
# http://<REMOTE_VM_IP>:3000 and http://<REMOTE_VM_IP>:8000 when set.
REMOTE_VM_IP=
# Comma-separated full Origin URLs, e.g. CORS_EXTRA_ORIGINS=https://homeyai.freeddns.org
# CORS_EXTRA_ORIGINS=
# Public HTTPS domain for Caddy (Let's Encrypt). Required for internet-facing prod deploy.
# Example uses Dynu (free dynamic DNS); any provider works.
# PUBLIC_DOMAIN=homeyai.freeddns.org
# Exposed to the admin health page in the browser (set automatically in Docker Compose
# from REMOTE_VM_IP; for local `npm run dev`, copy REMOTE_VM_IP or set explicitly):
# NEXT_PUBLIC_REMOTE_VM_IP=${REMOTE_VM_IP}

# ------------------------------------------------------------------------------
# 3. CHOOSE YOUR MODE:
# ------------------------------------------------------------------------------
# HOW NETWORKING WORKS OVERVIEW:
# When deployed on the VM, Docker automatically creates an internal network.
# Services connect using their container names (e.g., backend connects to 'db'
# and 'minio' natively without needing an IP or port configuration).
# The only configuration required is the NEXT_PUBLIC_API_URL, which tells the
# Next.js frontend running in the user's browser where to send requests externally.
#
# Login calls the FastAPI backend (not Postgres). DB_HOST is server-side only.
# If you open the UI at http://<TAILSCALE_OR_PUBLIC_IP>:3000, do NOT set NEXT_PUBLIC_API_URL
# to http://localhost:8000 — the browser's "localhost" is the user's laptop. Prefer leaving
# NEXT_PUBLIC_API_URL unset (docker-compose.dev) so /api is same-origin and proxied, or set it to
# http://<same-host-you-use-in-the-browser>:8000 when the API is reachable there.
#
# When the frontend calls the API directly (non-empty NEXT_PUBLIC_API_URL), the backend must allow
# the page origin: set CORS_EXTRA_ORIGINS=http://YOUR_IP:3000 (comma-separated). Docker Compose
# forwards this env var into the backend container.
#
# Optional: HOMEYAI_MODELLING_DIR=/modelling (compose bind-mount) for modelling/outputs QA files and SHAP PNG.
# Experiment catalog and metrics come from MinIO (MODEL_ENV), not local experiment_runs files.

# --- MODE A: PRODUCTION RUN (On the Oracle VM) ---
# Caddy serves HTTPS on :443; Next.js proxies /api to backend inside Docker.
# DB_NAME=real_estate_db
# PUBLIC_DOMAIN=homeyai.freeddns.org
# NEXT_PUBLIC_API_URL=
# CORS_EXTRA_ORIGINS=https://homeyai.freeddns.org

# --- MODE B: LOCAL → PRODUCTION DB (via Tailscale) ---
# Use ONLY for verifying production data from your local machine.
# DB_NAME=real_estate_db
# DB_HOST=${REMOTE_VM_IP}
# DB_INNER_PORT=5432
# DB_PORT=5432
# MINIO_HOST=${REMOTE_VM_IP}
# MINIO_INNER_PORT=9000
# NEXT_PUBLIC_API_URL=http://localhost:8000

# --- MODE C: LOCAL → DEVELOPMENT DB (via Tailscale) — RECOMMENDED ---
# Use this for daily development. Connects to the isolated dev database.
# Requires Tailscale to be installed and connected.
# Start with: docker compose -f docker-compose.dev.yml up --build
# DB_NAME=real_estate_dev_db
# DB_HOST=${REMOTE_VM_IP}
# DB_INNER_PORT=5433
# MINIO_HOST=${REMOTE_VM_IP}
# MINIO_INNER_PORT=9000
# PREFECT_API_URL=http://${REMOTE_VM_IP}:4201/api
# NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Optional: ML Model Environment ---
# MODEL_ENV=dev     # Load models from models/dev/ in MinIO (default: prod)

# ------------------------------------------------------------------------------
# ML training (read-only DB user — see backend/scripts/sql/create_ml_readonly_role.sql)
# Use READ_ONLY_DB_* (underscores), not hyphens — valid bash names and safe for `source .env`.
# ------------------------------------------------------------------------------
# Prefer component vars (modelling/training_db.py assembles the URL). Never use the admin URL for training.
READ_ONLY_DB_USER=ml_training_readonly
READ_ONLY_DB_PASSWORD=YOUR_PASSWORD
# Optional: override assembled URL
# DATABASE_URL_READ_ONLY=postgresql://ml_training_readonly:YOUR_PASSWORD@${REMOTE_VM_IP}:5433/real_estate_dev_db
