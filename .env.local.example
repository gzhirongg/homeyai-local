# Standalone Docker setup; no Tailscale or team VM required.
LOCAL_FRONTEND_PORT=3001
LOCAL_BACKEND_PORT=8001
LOCAL_MINIO_PORT=9000
LOCAL_MINIO_CONSOLE_PORT=9001
LOCAL_PREFECT_PORT=4201
LOCAL_DB_PASSWORD=homeyai_local_password
LOCAL_MINIO_PASSWORD=homeyai_local_storage

# Optional integrations. Leave blank until you have valid credentials.
URA_API_KEY=
MAS_API_KEY=
OPENAI_API_KEY=
ONEMAP_EMAIL_1=
ONEMAP_PASSWORD_1=

# Requires a real model + manifest/metrics in the local MinIO models bucket.
VALUATION_MODEL_OBJECT_KEY=
